{
  "info": {
    "name": "KLE Blog API",
    "description": "docs/openapi.yaml ile birebir aynı sözleşme. Tüm istekler `Accept: application/json` gönderir; korumalı istekler koleksiyon seviyesindeki `Authorization: Bearer {{token}}` başlığını kullanır. Login/Register yanıtı `token` değişkenini otomatik doldurur, Logout temizler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "postSlug",
      "value": "ornek-yazi"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "categorySlug",
      "value": "yazilim"
    },
    {
      "key": "commentId",
      "value": "1"
    },
